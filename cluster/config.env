# Cluster settings. Override any value with an environment variable,
# for example: NODES=2 make up
PROFILE="${PROFILE:-kcna}"
NODES="${NODES:-3}"
CPUS="${CPUS:-2}"
MEMORY="${MEMORY:-3500}"
DRIVER="${DRIVER:-docker}"
CONTAINER_RUNTIME="${CONTAINER_RUNTIME:-containerd}"
K8S_VERSION="${K8S_VERSION:-v1.35.1}"
CILIUM_VERSION="${CILIUM_VERSION:-1.20.4}"
